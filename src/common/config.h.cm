#cmakedefine _GNU_SOURCE

/* Define to 1 if strnlen is available */
#cmakedefine HAVE_STRNLEN

/* Define to 1 if setrlimit is available */
#cmakedefine HAVE_SETRLIMIT

/* Define to 1 if execinfo is available */
#cmakedefine HAVE_EXECINFO

/* Define to 1 if monotonic clock available */
#cmakedefine HAVE_MONOTONIC_CLOCK

/* Define to 1 if Thread Local Storage is available */
#cmakedefine HAS_TLS

/* Define to 1 if debugging */
#cmakedefine DEBUG

/* Define to 1 if epoll is enabled */
#cmakedefine SOCKET_EPOLL
